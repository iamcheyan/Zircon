<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\LibraryCore\LibraryCore.csproj" />
    <!-- ServerLibrary is built by the solution/server build. Keeping this as a binary
         reference avoids pulling the server's full restore graph into this small tool. -->
    <Reference Include="ServerLibrary">
      <HintPath>..\..\ServerLibrary\bin\Debug\net10.0\ServerLibrary.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
